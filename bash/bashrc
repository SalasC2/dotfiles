# ~/.bashrc: executed by bash(1) for non-login shells.
# Managed in ~/dotfiles. Machine-specific stuff goes in ~/.bashrc.local (not in git).

# If not running interactively, don't do anything
case $- in
    *i*) ;;
      *) return;;
esac

# Load modular config
for file in ~/.bashrc.d/*.bashrc; do
    [ -f "$file" ] && . "$file"
done
unset file

# Per-machine overrides (PATH tweaks, work-only settings, etc.)
[ -f ~/.bashrc.local ] && . ~/.bashrc.local

# Attach ble.sh last, after prompt/completion setup is fully in place
[[ ${BLE_VERSION-} ]] && ble-attach
